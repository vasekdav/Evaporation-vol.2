{
  "name": "odparovac",
  "version": "0.1.0",
  "private": true,
  "description": "Výpočet a návrh atmosférických odpařovačů kryogenních kapalin (O₂, N₂)",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run test",
    "gen:tables": "python3 tools/gen_tables.py",
    "gen:check": "python3 tools/gen_tables.py --check"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "~5.9.3",
    "vitest": "^3.2.7"
  }
}
